##########################################################################################################################
# MC02 (STM32H723VGTx) recursive Makefile, adapted from rm_gongcheng/Makefile.upgrade
##########################################################################################################################

# ------------------------------------------------
# Generic Makefile (based on gcc)
#
# ChangeLog :
#	2017-02-10 - Several enhancements + project update mode
#   2015-07-22 - first version
# ------------------------------------------------


######################################
# target
######################################
TARGET = Basic_Framework_MC02


######################################
# building variables
######################################
# debug build?
DEBUG = 1
# optimization
OPT = -Og


#######################################
# paths
#######################################
# Build path
BUILD_DIR = build

######################################
# source
######################################
# 只递归这些目录. Drivers/Middlewares 是完整 Cube 包, 整棵扫会把
# 其它内核移植、heap 实现和 *_template.c 一起编进来, 造成重定义.

PROJ_DIR = \
Core/Src \
USB_DEVICE \
application \
modules \
bsp \
Engineer_Components_master/src \
Drivers/STM32H7xx_HAL_Driver/Src \
Middlewares/Third_Party/FreeRTOS/Source \
Middlewares/Third_Party/FreeRTOS/Source/CMSIS_RTOS \
Middlewares/Third_Party/FreeRTOS/Source/portable/GCC/ARM_CM4F \
Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang \
Middlewares/Third_Party/SEGGER/RTT \
Middlewares/ST/STM32_USB_Device_Library/Core/Src \
Middlewares/ST/STM32_USB_Device_Library/Class/CDC/Src

# 快速递归搜索当前目录下的.c文件,需在msys2/MinGW环境使用(Windows下),linux/macOS则可以直接使用
# windows下使用命令行(cmd)或powershell时,替换注释的内容.

# for unix/linux/macOS or Msys2/MinGW bash:
ALL_DIRS := $(foreach dire, $(PROJ_DIR), $(shell find $(dire) -maxdepth 10 -type d))
# for windows cmd/pwsh:
# SHELL = cmd
# ALL_DIRS := $(foreach dire, $(PROJ_DIR), $(shell dir $(dire) /s /b /a:d))
# ALL_DIRS += $(PROJ_DIR)


C_SOURCES := $(foreach dire, $(ALL_DIRS), $(wildcard $(dire)/*.c))

# HAL/USB 包里自带的模板会和 Core、USB_DEVICE 里的实现重定义
C_SOURCES := $(filter-out %_template.c,$(C_SOURCES))
# FreeRTOS 只使用 heap_4, 其余 heap 实现互斥
C_SOURCES := $(filter-out %/heap_1.c %/heap_2.c %/heap_3.c %/heap_5.c,$(C_SOURCES))

# ASM sources
ASM_SOURCES =  \
startup_stm32h723xx.s \
Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT_ASM_ARMv7M.s


#######################################
# binaries
#######################################
PREFIX = arm-none-eabi-
# The gcc compiler bin path can be either defined in make command via GCC_PATH variable (> make GCC_PATH=xxx)
# either it can be added to the PATH environment variable.
ifdef GCC_PATH
CC = $(GCC_PATH)/$(PREFIX)gcc
AS = $(GCC_PATH)/$(PREFIX)gcc -x assembler-with-cpp
CP = $(GCC_PATH)/$(PREFIX)objcopy
SZ = $(GCC_PATH)/$(PREFIX)size
else
CC = $(PREFIX)gcc
AS = $(PREFIX)gcc -x assembler-with-cpp
CP = $(PREFIX)objcopy
SZ = $(PREFIX)size
endif
HEX = $(CP) -O ihex
BIN = $(CP) -O binary -S

#######################################
# CFLAGS
#######################################
# cpu
CPU = -mcpu=cortex-m7

# fpu
FPU = -mfpu=fpv5-d16

# float-abi
FLOAT-ABI = -mfloat-abi=hard

# mcu
MCU = $(CPU) -mthumb $(FPU) $(FLOAT-ABI)

# macros for gcc
# AS defines
AS_DEFS =

# C defines
C_DEFS =  \
-DUSE_HAL_DRIVER \
-DSTM32H723xx \
-DARM_MATH_CM7 \
-DDISABLE_LOG_SYSTEM

# AS includes
AS_INCLUDES =  \
-ICore/Inc

# C includes
# 头文件目录单独列出: 只加包含目录, 不参与 .c 收集
C_INCLUDE_DIRS = \
Core/Inc \
USB_DEVICE/App \
USB_DEVICE/Target \
Drivers/STM32H7xx_HAL_Driver/Inc \
Drivers/STM32H7xx_HAL_Driver/Inc/Legacy \
Drivers/CMSIS/Device/ST/STM32H7xx/Include \
Drivers/CMSIS/Include \
Middlewares/Third_Party/FreeRTOS/Source/include \
Middlewares/Third_Party/FreeRTOS/Source/CMSIS_RTOS \
Middlewares/Third_Party/FreeRTOS/Source/portable/GCC/ARM_CM4F \
Middlewares/ST/STM32_USB_Device_Library/Core/Inc \
Middlewares/ST/STM32_USB_Device_Library/Class/CDC/Inc \
Middlewares/ST/ARM/DSP/Inc \
Middlewares/ST/ARM/DSP/Include/dsp \
Middlewares/Third_Party/SEGGER/RTT \
Middlewares/Third_Party/SEGGER/Config \
Engineer_Components_master/include \
$(ALL_DIRS)

C_INCLUDES := $(addprefix -I,$(C_INCLUDE_DIRS))


# compile gcc flags
ASFLAGS = $(MCU) $(AS_DEFS) $(AS_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections

CFLAGS += $(MCU) $(C_DEFS) $(C_INCLUDES) $(OPT) -Wall -fdata-sections -ffunction-sections -fmessage-length=0

ifeq ($(DEBUG), 1)
CFLAGS += -g -gdwarf-2
endif


# Generate dependency information
CFLAGS += -MMD -MP -MF"$(@:%.o=%.d)"


#######################################
# LDFLAGS
#######################################
# link script
LDSCRIPT = STM32H723VGTx_FLASH.ld

# libraries
LIBS = -lc -lm -lnosys -larm_cortexM7lfdp_math
LIBDIR = -LDrivers/CMSIS/DSP/Lib/GCC
LDFLAGS = $(MCU) -specs=nano.specs -T$(LDSCRIPT) $(LIBDIR) $(LIBS) -Wl,-Map=$(BUILD_DIR)/$(TARGET).map,--cref -Wl,--gc-sections,--print-memory-usage

# default action: build all
all: $(BUILD_DIR)/$(TARGET).elf $(BUILD_DIR)/$(TARGET).hex $(BUILD_DIR)/$(TARGET).bin


#######################################
# build the application
#######################################
# list of objects
OBJECTS = $(addprefix $(BUILD_DIR)/,$(notdir $(C_SOURCES:.c=.o)))
vpath %.c $(sort $(dir $(C_SOURCES)))
# list of ASM program objects
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ASM_SOURCES:.s=.o)))
vpath %.s $(sort $(dir $(ASM_SOURCES)))

$(BUILD_DIR)/%.o: %.c Makefile.upgrade | $(BUILD_DIR)
	@$(CC) -c $(CFLAGS) -Wa,-a,-ad,-alms=$(BUILD_DIR)/$(notdir $(<:.c=.lst)) $< -o $@

$(BUILD_DIR)/%.o: %.s Makefile.upgrade | $(BUILD_DIR)
	@$(AS) -c $(CFLAGS) $< -o $@

$(BUILD_DIR)/$(TARGET).elf: $(OBJECTS) Makefile.upgrade
	@$(CC) $(OBJECTS) $(LDFLAGS) -o $@
	$(SZ) $@

$(BUILD_DIR)/%.hex: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(HEX) $< $@

$(BUILD_DIR)/%.bin: $(BUILD_DIR)/%.elf | $(BUILD_DIR)
	$(BIN) $< $@

$(BUILD_DIR):
	@mkdir $@


#######################################
# clean up
#######################################
clean:
	rd $(BUILD_DIR) /s/q


#######################################
# dependencies
#######################################
-include $(wildcard $(BUILD_DIR)/*.d)


#######################################
# download directl without debugging
#######################################
# 工程版的 stm32.jflash 绑定的是 STM32F407IG, 不能用来烧 H723.
# 这里改用 JLink Commander, 设备名与 .vscode/launch.json 一致.
download_dap:
	openocd -f openocd_dap.cfg -c init -c halt -c "flash write_image erase $(BUILD_DIR)/$(TARGET).bin 0x08000000" -c reset -c shutdown
download_jlink:
	printf "device STM32H723VG\nif SWD\nspeed 4000\nconnect\nerase\nloadfile $(BUILD_DIR)/$(TARGET).hex\nr\ng\nexit\n" | JLink

# *** EOF ***
